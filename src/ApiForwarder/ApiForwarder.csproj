<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApiForwarder</RootNamespace>
    <AssemblyName>ApiForwarder</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensure the runtime data folder is created on publish -->
    <None Include="App_Data\.gitkeep" CopyToOutputDirectory="PreserveNewest" Condition="Exists('App_Data\.gitkeep')" />
  </ItemGroup>

</Project>
